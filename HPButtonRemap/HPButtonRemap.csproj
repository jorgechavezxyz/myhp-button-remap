<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Single source of the release version: the workflow passes it to the MSI and checks the tag. -->
    <Version>1.0.4</Version>
    <ApplicationIcon>tray.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.1" />
    <EmbeddedResource Include="tray.ico" />
    <InternalsVisibleTo Include="HPButtonRemap.Tests" />
  </ItemGroup>

</Project>
